{
  "namespace": "start",
  "modsbutton_button@start.main_button": {
    "$button_text": "modsbutton.ui.label",
    "$pressed_button_name": "button.mods_button_clicked",
    "$focus_id": "modsbutton_button",
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      }
    ]
  },
  "main_buttons_panel/stacked_rows": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_after",
        "control_name": "play",
        "value": {
          "modsbutton_row@start.stacked_row": {
            "controls": [
              {
                "modsbutton_button@start.modsbutton_button": {}
              }
            ]
          }
        }
      }
    ]
  }
}
